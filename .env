# ymcloud 单机部署配置（UTF-8）。默认值可直接用于快速部署测试。
# 正式上线前必须修改下方 4 个密码、3 个服务密钥，并修改网站初始管理员密码。
# 在部署目录运行 docker compose up -d，自动拉取固定版本的镜像并启动整个网站。
# 需要 Docker Compose v2.20+。Linux amd64 / cgroup v2；Windows Docker Desktop 可本地体验。

# ===== 镜像来源：下载较慢时只改这一项 =====
# 默认使用腾讯云；拉取失败时可改为 Docker Hub 主仓库 docker.io/yemiao1/ymoj。
# Compose 已填写本次发布的七个镜像版本标签，无需再填写版本号或修改其他配置。
IMAGE_REPOSITORY=ccr.ccs.tencentyun.com/ymoj/ymcloud

# ===== 1. 网站地址：通常只需修改端口 =====
# 浏览器访问 http://服务器IP:端口；80 可以省略。端口被占用时可改为 8080。
HTTP_PORT=80
# 0.0.0.0 允许外部访问；仅本机体验改为 127.0.0.1。
HTTP_BIND=0.0.0.0
# 项目名称决定容器和数据卷名称。安装后不要改，否则会看到一套新的空数据。
COMPOSE_PROJECT_NAME=ymcloud
# 网站业务时区，默认北京时间。比赛时间与日期按此时区解释，安装后不要随意切换。
TZ=Asia/Shanghai

# ===== 2. 数据库、缓存和消息密码：默认仅供快速测试，正式上线前全部修改 =====
# 自定义密码至少 16 位，彼此不要相同；建议使用随机大小写字母和数字。
# 包含 $ 或 # 等符号时，将整个值放在单引号中，如 KEY='完整密码'。
# 初始化后 MySQL 和 RabbitMQ 的密码保存在数据卷；不能仅改本文件来修改已有账号密码。
MYSQL_ROOT_PASSWORD=ymcloudRoot123456
# Web 只用此应用账号连接数据库，不使用上面的 root 管理员账号。
MYSQL_PASSWORD=ymcloudMysql123456
REDIS_PASSWORD=ymcloudRedis123456
RABBITMQ_PASSWORD=ymcloudRabbit123456

# ===== 3. 服务密钥：不是网站登录密码，正式上线前全部改为独立随机字符串 =====
# 登录签名密钥至少 64 位。后续启动保留原值，修改会使原登录令牌失效。
TOKEN_SECRET=ymcloud_test_login_secret_0123456789_abcdefghijklmnopqrstuvwxyz_0123456789
# Worker 下载测试数据的密钥，至少 32 位；Compose 自动同时传给 Web 和 Worker。
WORKER_TOKEN=ymcloud_test_worker_token_0123456789abcdef
# go-judge 沙箱接口密钥，至少 32 位；Compose 自动同时传给 Worker 和沙箱。
GO_JUDGE_TOKEN=ymcloud_test_go_judge_token_0123456789abcdef

# ===== 4. 邮件（可不填，不影响登录、提交和判题） =====
# 仅密码找回等功能使用。当前程序支持 QQ 邮箱 SMTP，MAIL_PASS 填邮箱授权码。
MAIL_FROM=
MAIL_PASS=

# ===== 5. 判题容量（2 核 4GB 先保持默认；以下参数需要配套修改） =====
# 同时评测任务数。沙箱和 Worker 共用此值。
JUDGE_CONCURRENCY=1
# 全部沙箱共享的 CPU 核数，不绑定独占核心。
JUDGE_CPUS=1.0
# 每任务 CPU 预算，1000 表示 1 核。
JUDGE_CPU_RATE=1000
# go-judge 总内存，单位字节；1073741824=1GiB，2147483648=2GiB；禁用 swap。
JUDGE_MEMORY_BYTES=1073741824
# 单题支持上限，单位 KiB；524288=512MiB。超出上限的题目明确返回 SE，不截短限额。
JUDGE_MAX_MEMORY_KIB=524288
# 编译内存，单位字节；536870912=512MiB。
JUDGE_COMPILE_MEMORY_BYTES=536870912
# 编译墙钟限制，单位毫秒；10000=10秒。
JUDGE_COMPILE_WALL_MS=10000
# 单次沙箱进程与线程上限，以及整个 go-judge 服务的总进程与线程上限。
JUDGE_PROCESS_LIMIT=64
JUDGE_PIDS=256

# Worker 自身资源。提高并发时也需要提高这四项，预检会拒绝不足的配套预算。
# Java 堆至少为 128 + 64 × (并发数-1) MiB；容器内存至少比堆多 256 MiB。
WORKER_HEAP_MIB=128
WORKER_MEMORY_MIB=384
# Worker CPU 至少为并发数 × 0.5；进程/线程数至少为 64 + 并发数 × 64。
WORKER_CPUS=0.5
WORKER_PIDS=128

# ===== 6. 应用日志（Web 和 Worker 共用规则，各自独立保存） =====
# 默认 INFO，能看到启动、判题与异常；临时排查可改为 DEBUG，完成后恢复 INFO。
LOG_LEVEL=INFO
# 按天归档，单文件达到此大小也会滚动；历史文件压缩为 .gz。
LOG_FILE_SIZE=20MB
# application.log 和 error.log 各自最多保留这些天数，并受各自归档总大小限制。
LOG_HISTORY_DAYS=15
LOG_TOTAL_SIZE=200MB

# 数据自动保存在本项目专用 Docker 数据卷中，普通 down/up 不会删除。
# 不要执行 docker compose down -v，除非明确要删除网站、数据库、文件和结果日志。
# 不需要手填容器IP、数据库地址、队列名、文件目录或各服务端口。
